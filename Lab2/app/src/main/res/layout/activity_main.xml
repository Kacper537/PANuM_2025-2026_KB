<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/romanText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Roman:"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/arabicText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Arabic:"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="40dp"/>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:alignmentMode="alignMargins"
        android:columnCount="3"
        android:rowCount="6"
        android:useDefaultMargins="true">


        <Button
            android:id="@+id/btn7"
            style="@style/MyButtonStyle"
            android:text="7" />

        <Button
            android:id="@+id/btn8"
            style="@style/MyButtonStyle"
            android:text="8" />

        <Button
            android:id="@+id/btn9"
            style="@style/MyButtonStyle"
            android:text="9" />

        <Button
            android:id="@+id/btn4"
            style="@style/MyButtonStyle"
            android:text="4" />

        <Button
            android:id="@+id/btn5"
            style="@style/MyButtonStyle"
            android:text="5" />

        <Button
            android:id="@+id/btn6"
            style="@style/MyButtonStyle"
            android:text="6" />

        <Button
            android:id="@+id/btn1"
            style="@style/MyButtonStyle"
            android:text="1" />

        <Button
            android:id="@+id/btn2"
            style="@style/MyButtonStyle"
            android:text="2" />

        <Button
            android:id="@+id/btn3"
            style="@style/MyButtonStyle"
            android:text="3" />

        <Button
            android:id="@+id/btnB"
            style="@style/MyButtonStyle"
            android:text="B" />

        <Button
            android:id="@+id/btn0"
            style="@style/MyButtonStyle"
            android:text="0" />

        <Button
            android:id="@+id/btnCLR"
            style="@style/MyButtonStyle"
            android:text="C" />


        <Space
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_columnSpan="3"/>


        <Button
            android:id="@+id/btnI"
            style="@style/MyButtonStyle"
            android:text="I" />

        <Button
            android:id="@+id/btnV"
            style="@style/MyButtonStyle"
            android:text="V" />

        <Button
            android:id="@+id/btnX"
            style="@style/MyButtonStyle"
            android:text="X" />

        <Button
            android:id="@+id/btnL"
            style="@style/MyButtonStyle"
            android:text="L" />

        <Button
            android:id="@+id/btnC"
            style="@style/MyButtonStyle"
            android:text="C" />

        <Button
            android:id="@+id/btnD"
            style="@style/MyButtonStyle"
            android:text="D" />

        <Space
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnM"
            style="@style/MyButtonStyle"
            android:text="M" />

        <Space
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </GridLayout>

</LinearLayout>